# Terraform working files
**/.terraform/*
*.tfstate
*.tfstate.*
*.tfplan
crash.log
crash.*.log

# Terraform variable files
# Ignore Terraform variable files by default
*.tfvars

# Allow environment-specific configuration required by Jenkins
!terraform/environments/dev/terraform.tfvars
!terraform/environments/staging/terraform.tfvars
!terraform/environments/prod/terraform.tfvars
*.tfvars.json

# Local overrides
override.tf
override.tf.json
*_override.tf
*_override.tf.json

# Sensitive credentials and keys
*.pem
*.key
*.p12
*.pfx
*.ppk
.env
.env.*

# AWS credentials
.aws/
credentials
config

# Jenkins temporary files
jenkins_home/
*.log

# Operating system files
.DS_Store
Thumbs.db

# IDE files
.vscode/
.idea/

# Local backups and temporary files
*.backup
*.bak
*.tmp

# Terraform state backups
**/state-backup.json
**/terraform.tfstate*
